{
  "name": "ez-php/tenancy",
  "version": "2.6.4",
  "description": "Single-database multi-tenancy primitives: tenant resolution per request, tenant context, tenant-scoped cache and search",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Andreas Uretschnig",
      "email": "andreas.uretschnig@gmail.com"
    }
  ],
  "keywords": ["tenancy", "multi-tenant", "php", "ez-php"],
  "homepage": "https://github.com/ez-php/tenancy",
  "support": {
    "issues": "https://github.com/ez-php/tenancy/issues",
    "source": "https://github.com/ez-php/tenancy"
  },
  "require": {
    "php": "^8.5",
    "ez-php/contracts": "^2.6.0",
    "ez-php/http": "^2.6.0"
  },
  "suggest": {
    "ez-php/cache": "Needed for Cache\\TenantScopedCache (per-tenant key prefixes on a shared store)",
    "ez-php/search": "Needed for Search\\TenantScopedSearchDriver (per-tenant index names)"
  },
  "require-dev": {
    "ez-php/docker": "^2.6.3",
    "ez-php/testing-application": "^2.6.0",
    "ez-php/cache": "^2.6.0",
    "ez-php/search": "^2.6.0",
    "phpunit/phpunit": "^13.0",
    "phpstan/phpstan": "^2.1",
    "friendsofphp/php-cs-fixer": "^3.94",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpstan/phpstan-deprecation-rules": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "EzPhp\\Tenancy\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "cs": "php-cs-fixer fix",
    "analyse": "phpstan analyse",
    "test": "phpunit",
    "full": "composer analyse && composer cs && composer test"
  }
}
